      },
      "delete": {
        "tags": ["products"],
        "responses": { "204": { "description": "No Content" } }
      }
    },
    "/active_users_view": {
      "get": {
        "tags": ["active_users_view"],
        "parameters": [{ "$ref": "#/parameters/select" }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/restricted_table": {
      "get": {
        "tags": ["restricted_table"],
        "parameters": [{ "$ref": "#/parameters/select" }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/rpc/get_user_stats": {
      "get": {
        "tags": ["(rpc) get_user_stats"],
        "summary": "Aggregate statistics for one user",
        "description": "Returns lifetime totals.",
        "parameters": [
          { "name": "user_id", "in": "query", "required": true, "type": "integer", "format": "int32" },
          { "name": "since", "in": "query", "required": false, "type": "string", "format": "date" }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["(rpc) get_user_stats"],
        "summary": "Aggregate statistics for one user",
        "description": "Returns lifetime totals.",
        "parameters": [
          {
            "name": "args",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "description": "Aggregate statistics for one user\n\nReturns lifetime totals.",
              "required": ["user_id"],
              "properties": {
                "since": { "format": "date", "type": "string" },
                "user_id": { "format": "int32", "type": "integer" }
              }
            }
          },
          { "$ref": "#/parameters/preferParams" }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/rpc/create_order": {
      "post": {
        "tags": ["(rpc) create_order"],
        "summary": "Create an order",
        "description": "Inserts a row and returns its id.",
        "parameters": [
          {
            "name": "args",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "description": "Create an order\n\nInserts a row and returns its id.",
              "required": ["user_id", "status"],
              "properties": {
                "items": { "format": "text[]", "items": { "type": "string" }, "type": "array" },
                "status": { "format": "order_status", "type": "string" },
                "user_id": { "format": "int64", "type": "integer" }
              }
            }
          },
          { "$ref": "#/parameters/preferParams" }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/rpc/ping": {
      "post": {
        "tags": ["(rpc) ping"],
        "summary": "Health check",
        "parameters": [
          {
            "name": "args",
