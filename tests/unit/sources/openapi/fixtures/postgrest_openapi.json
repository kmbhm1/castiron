    "/rpc/search_products": {
      "get": {
        "tags": ["(rpc) search_products"],
        "summary": "Search products",
        "description": "Returns matching product rows.",
        "parameters": [
          {
            "name": "terms",
            "in": "query",
            "required": true,
            "type": "array",
            "format": "text[]",
            "items": { "type": "string" },
            "collectionFormat": "multi"
          },
          { "name": "limit_to", "in": "query", "required": false, "type": "integer", "format": "int32" }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["(rpc) search_products"],
        "summary": "Search products",
        "description": "Returns matching product rows.",
        "parameters": [
          {
            "name": "args",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "description": "Search products\n\nReturns matching product rows.",
              "required": ["terms"],
              "properties": {
                "limit_to": { "format": "int32", "type": "integer" },
                "terms": { "format": "text[]", "items": { "type": "string" }, "type": "array" }
              }
            }
          },
          { "$ref": "#/parameters/preferParams" }
        ],
        "responses": { "200": { "description": "OK" } }
      }
