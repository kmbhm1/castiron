{
  "swagger": "2.0",
  "info": {
    "version": "14.14",
    "title": "standard public schema",
    "description": "This is a RESTful API for the public schema."
  },
  "host": "example.supabase.co:443",
  "basePath": "/rest/v1/",
  "schemes": ["https"],
  "consumes": ["application/json", "application/vnd.pgrst.object+json"],
  "produces": ["application/json", "application/vnd.pgrst.object+json"],
  "externalDocs": {
    "description": "PostgREST Documentation",
    "url": "https://postgrest.org/en/stable/references/api.html"
  },
  "definitions": {
    "users": {
      "type": "object",
      "description": "Application users.",
      "required": ["id", "email", "status", "login_count", "is_active"],
      "properties": {
        "id": {
          "description": "Note:\nThis is a Primary Key.<pk/>",
          "format": "int32",
          "type": "integer"
        },
        "email": {
          "format": "character varying",
          "maxLength": 255,
          "type": "string"
        },
        "created_at": {
          "default": "now()",
          "format": "timestamp with time zone",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": ["pending", "shipped", "cancelled"],
          "format": "order_status",
          "type": "string"
        },
        "metadata": {
          "format": "jsonb"
        },
        "tags": {
          "format": "text[]",
          "items": { "type": "string" },
          "type": "array"
        },
        "bio": {
          "description": "A short profile blurb.",
          "format": "text",
          "type": "string"
        },
        "class": {
          "format": "text",
          "type": "string"
        },
        "login_count": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "is_active": {
          "default": false,
          "format": "boolean",
          "type": "boolean"
        }
      }
    },
    "orders": {
      "type": "object",
      "description": "Customer orders.",
      "required": ["id", "user_id", "total"],
      "properties": {
        "id": {
          "description": "Note:\nThis is a Primary Key.<pk/>",
          "format": "int64",
          "type": "integer"
        },
        "user_id": {
          "description": "The customer who placed the order.\n\nNote:\nThis is a Foreign Key to `users.id`.<fk table='users' column='id'/>",
          "format": "int32",
          "type": "integer"
        },
        "total": {
          "format": "numeric",
          "type": "number"
        },
        "code": {
          "format": "character",
          "maxLength": 1,
          "type": "string"
        },
        "labels": {
          "format": "order_status[]",
          "items": { "type": "string" },
          "type": "array"
        }
      }
    },
    "order_items": {
      "type": "object",
      "required": ["order_id", "product_id", "quantity"],
      "properties": {
        "order_id": {
          "description": "Note:\nThis is a Primary Key.<pk/>\nThis is a Foreign Key to `orders.id`.<fk table='orders' column='id'/>",
          "format": "int64",
          "type": "integer"
        },
        "product_id": {
          "description": "Note:\nThis is a Primary Key.<pk/>\nThis is a Foreign Key to `products.id`.<fk table='products' column='id'/>",
          "format": "int32",
          "type": "integer"
        },
        "quantity": {
          "format": "int32",
          "type": "integer"
        },
        "status": {
          "enum": ["pending", "shipped", "cancelled"],
          "format": "order_status",
          "type": "string"
        }
      }
    },
    "products": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "description": "Note:\nThis is a Primary Key.<pk/>",
          "format": "int32",
          "type": "integer"
        },
        "name": {
          "format": "text",
          "type": "string"
        }
      }
    },
    "active_users_view": {
      "type": "object",
      "description": "Users with a recent login.",
      "properties": {
        "id": {
          "description": "Note:\nThis is a Primary Key.<pk/>",
          "format": "int32",
          "type": "integer"
        },
        "email": {
          "format": "character varying",
          "maxLength": 255,
          "type": "string"
        },
        "favorite_product_id": {
          "description": "Note:\nThis is a Foreign Key to `products.id`.<fk table='products' column='id'/>",
          "format": "int32",
          "type": "integer"
        }
      }
    },
    "restricted_table": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "description": "Note:\nThis is a Primary Key.<pk/>",
          "format": "int32",
          "type": "integer"
        },
        "secret": {
          "format": "text",
          "type": "string"
        },
        "owner_id": {
          "description": "Note:\nThis is a Foreign Key to `active_users_view.id`.<fk table='active_users_view' column='id'/>",
          "format": "int32",
          "type": "integer"
        }
      }
    }
  },
  "parameters": {
    "preferParams": {
      "name": "Prefer",
      "in": "header",
      "type": "string",
      "required": false,
      "enum": ["params=single-object"]
    },
    "select": {
      "name": "select",
      "in": "query",
      "description": "Filtering Columns",
      "required": false,
      "type": "string"
    },
    "offset": {
      "name": "offset",
      "in": "query",
      "description": "Limiting and Pagination",
      "required": false,
      "type": "string"
    }
  },
